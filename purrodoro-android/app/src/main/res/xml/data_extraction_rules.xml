<?xml version="1.0" encoding="utf-8"?>
<!--
  Room (tasks, habits, session history) is included so Auto Backup and
  device-to-device transfer can restore it. Auth is gone. Downloaded cloud
  audio and plaintext JSON safety copies stay out so they cannot blow the
  25 MB backup quota.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="backups/" />
        <exclude domain="file" path="backup-status/" />
        <exclude domain="file" path="soundscapes/" />
        <exclude domain="file" path="soundscape-thumbs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="backups/" />
        <exclude domain="file" path="backup-status/" />
        <exclude domain="file" path="soundscapes/" />
        <exclude domain="file" path="soundscape-thumbs/" />
    </device-transfer>
</data-extraction-rules>
