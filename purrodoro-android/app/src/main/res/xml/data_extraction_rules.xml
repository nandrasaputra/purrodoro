<?xml version="1.0" encoding="utf-8"?>
<!--
  Exclude auth session, Room DB, and plaintext safety backups from cloud backup
  and device-to-device transfer. See release-readiness.md §4.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="purrodoro_auth_session.xml" />
        <exclude domain="database" path="purrodoro.db" />
        <exclude domain="database" path="purrodoro.db-shm" />
        <exclude domain="database" path="purrodoro.db-wal" />
        <exclude domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="purrodoro_auth_session.xml" />
        <exclude domain="database" path="purrodoro.db" />
        <exclude domain="database" path="purrodoro.db-shm" />
        <exclude domain="database" path="purrodoro.db-wal" />
        <exclude domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
